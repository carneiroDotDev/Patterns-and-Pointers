    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": ["comment", "punctuation.definition.comment"],
                "settings": {
                    "foreground": "#565f89",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator.new"],
                "settings": {
                    "foreground": "#bb9af7"
                }
            },
            {
                "scope": ["keyword.control", "keyword.control.flow", "keyword.operator.expression"],
                "settings": {
                    "foreground": "#bb9af7",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": ["entity.name.function", "support.function", "meta.function-call"],
                "settings": {
                    "foreground": "#7aa2f7"
                }
            },
            {
                "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
                "settings": {
                    "foreground": "#2ac3de"
                }
            },
            {
                "scope": ["entity.name.type.interface", "entity.name.type.alias"],
                "settings": {
                    "foreground": "#7dcfff"
                }
            },
            {
                "scope": ["string", "punctuation.definition.string", "string.template"],
                "settings": {
                    "foreground": "#9ece6a"
                }
            },
            {
                "scope": ["constant.numeric", "constant.language", "constant.other"],
                "settings": {
                    "foreground": "#ff9e64"
                }
            },
            {
                "scope": ["variable", "variable.other", "variable.parameter"],
                "settings": {
                    "foreground": "#c0caf5"
                }
            },
            {
                "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
                "settings": {
                    "foreground": "#73daca"
                }
            },
            {
                "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
                "settings": {
                    "foreground": "#89ddff"
                }
            },
            {
                "scope": ["entity.name.tag", "meta.tag.sgml"],
                "settings": {
                    "foreground": "#f7768e"
                }
            },
            {
                "scope": ["entity.other.attribute-name"],
                "settings": {
                    "foreground": "#bb9af7"
                }
            },
            {
                "scope": ["punctuation.definition.tag"],
                "settings": {
                    "foreground": "#565f89"
                }
            },
            {
                "scope": ["markup.heading", "markup.heading.markdown"],
                "settings": {
                    "foreground": "#7aa2f7",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": ["markup.bold"],
                "settings": {
                    "foreground": "#e0af68",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": ["markup.italic"],
                "settings": {
                    "foreground": "#bb9af7",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": ["markup.inline.raw", "markup.fenced_code.block"],
                "settings": {
                    "foreground": "#73daca"
                }
            }
        ]
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "peacock.color": "#7aa2f7",
    "vim.handleKeys": {
        "<C-p>": false,
        "<C-j>": false,
        "<C-f>": false,
        "<C-e>": false
    }
}